{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "assignees": ["baragoon"],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": ["/^README\\.md$/"],
      "matchStrings": [
        "(?<depName>ghcr\\.io/baragoon/traefik-kop):(?<currentValue>\\d+\\.\\d+\\.\\d+)"
      ],
      "datasourceTemplate": "docker",
      "versioningTemplate": "semver"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["/^README\\.md$/"],
      "matchStrings": [
        "image:\\s*['\"]?(?<depName>nginx):(?<currentValue>\\d+\\.\\d+\\.\\d+-alpine\\d+\\.\\d+)['\"]?"
      ],
      "datasourceTemplate": "docker",
      "versioningTemplate": "regex:^(?<major>\\d+)\\.(?<minor>\\d+)(?:\\.(?<patch>\\d+))?-alpine(?<build>\\d+)\\.(?<revision>\\d+)$"
    },
    {
      "customType": "regex",
      "description": "Update Go version in GitHub workflows",
      "managerFilePatterns": ["/^\\.github/workflows/.+\\.ya?ml$/"],
      "matchStrings": [
        "go-version:\\s*['\"]?(?<currentValue>\\d+\\.\\d+(?:\\.\\d+)?)['\"]?"
      ],
      "depNameTemplate": "go",
      "packageNameTemplate": "golang/go",
      "datasourceTemplate": "golang-version",
      "versioningTemplate": "semver"
    }
  ],
  "extends": [
    "config:best-practices"
  ],
  "osvVulnerabilityAlerts": true,
  "packageRules": [
    {
      "matchManagers": ["gomod"],
      "matchDepNames": ["go"],
      "matchDepTypes": ["golang"],
      "rangeStrategy": "bump"
    },
    {
      "matchDepNames": ["go"],
      "groupName": "go toolchain"
    },
    {
      "matchManagers": ["custom.regex"],
      "matchPackageNames": ["ghcr.io/baragoon/traefik-kop"],
      "pinDigests": false,
      "automerge": true,
      "automergeType": "branch",
      "ignoreTests": true
    },
    {
      "matchManagers": ["custom.regex"],
      "matchPackageNames": ["nginx"],
      "pinDigests": false,
      "automerge": true,
      "automergeType": "branch",
      "ignoreTests": true
    },
    {
      "matchManagers": ["docker-compose"],
      "matchUpdateTypes": ["minor", "patch", "digest", "pin", "pinDigest"],
      "automerge": true,
      "automergeType": "branch",
      "ignoreTests": true
    },
    {
      "matchDatasources": ["go"],
      "matchPackageNames": ["github.com/containous/go-http-auth"],
      "enabled": false
    }
  ]
}