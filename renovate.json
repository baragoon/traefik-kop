{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "assignees": ["baragoon"],
  "extends": [
    "config:recommended",
    "helpers:pinGitHubActionDigests"
  ],
  "packageRules": [
    {
      "matchManagers": ["gomod"],
      "matchDepNames": ["go"],
      "matchDepTypes": ["golang"],
      "rangeStrategy": "bump"
    },
    {
      "matchDatasources": ["go"],
      "matchPackageNames": ["github.com/containous/go-http-auth"],
      "enabled": false
    }
  ]
}
